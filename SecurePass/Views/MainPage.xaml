<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SecurePass.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="Мои пароли">

    <!-- Привязываем системное событие Appearing страницы к нашей новой команде -->
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior 
            EventName="Appearing" 
            Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto, *, Auto" RowSpacing="10" Padding="10">

        <SearchBar
            Grid.Row="0"
            Text="{Binding SearchText}"
            Placeholder="Поиск паролей..."
            HeightRequest="50"/>

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding FilteredAccounts}"
            SelectedItem="{Binding SelectedAccount}"
            SelectionChangedCommand="{Binding EditAccountCommand}"
            SelectionMode="Single">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10" ColumnDefinitions="Auto, *" ColumnSpacing="15">
                        <Frame
                            Grid.Column="0"
                            Padding="0"
                            BackgroundColor="LightGray"
                            CornerRadius="25"
                            HasShadow="False"
                            HeightRequest="50"
                            WidthRequest="50">
                            <Image
                                HeightRequest="30"
                                HorizontalOptions="Center"
                                Source="{Binding IconSource}"
                                VerticalOptions="Center"/>
                        </Frame>
                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="{Binding Name}"
                            VerticalOptions="Center"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button 
            Grid.Row="2"
            Command="{Binding AddAccountCommand}"
            Text="Добавить пароль"
            BackgroundColor="#667eea"
            TextColor="White"
            HeightRequest="50"/>

    </Grid>
</ContentPage>