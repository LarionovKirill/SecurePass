<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SecurePass.Views.StartPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Shell.NavBarIsVisible="False">

    <Grid>
        <!-- Фоновый градиент -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#667eea"/>
                    <GradientStop Offset="1" Color="#764ba2"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <ScrollView>
            <VerticalStackLayout
                Padding="24"
                Spacing="20"
                VerticalOptions="Center">

                <!-- Логотип -->
                <HorizontalStackLayout HorizontalOptions="Center" Margin="0,0,0,20">
                    <Image
                        HeightRequest="48"
                        Source="sheld_icon_64x64.png"
                        WidthRequest="48"/>
                    <Label
                        FontAttributes="Bold"
                        FontSize="32"
                        Text="SecurePass"
                        TextColor="White"/>
                </HorizontalStackLayout>

                <!-- Карточка входа -->
                <Frame
                    Padding="20"
                    BackgroundColor="White"
                    CornerRadius="20"
                    HasShadow="True">

                    <VerticalStackLayout Spacing="16">

                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            HorizontalOptions="Center"
                            Text="Вход в приложение"
                            TextColor="#333333"/>

                        <!-- Поле ввода мастер-пароля -->
                        <Entry
                            Text="{Binding MasterPassword}"
                            IsPassword="True"
                            Placeholder="Введите мастер-пароль"
                            HeightRequest="50">
                            <Entry.Behaviors>
                                <toolkit:EventToCommandBehavior
                                    EventName="Completed"
                                    Command="{Binding LoginCommand}"/>
                            </Entry.Behaviors>
                        </Entry>

                        <!-- Кнопка входа -->
                        <Button
                            Command="{Binding LoginCommand}"
                            BackgroundColor="#667eea"
                            CornerRadius="10"
                            HeightRequest="50"
                            Text="Войти"
                            TextColor="White"/>

                        <!-- Кнопка биометрии -->
                        <Button
                            Command="{Binding BiometricLoginCommand}"
                            BackgroundColor="#F5F5F5"
                            CornerRadius="10"
                            HeightRequest="50"
                            IsVisible="{Binding IsBiometricVisible}"
                            Text="Войти по биометрии"
                            TextColor="#667eea"/>

                        <!-- Индикатор загрузки -->
                        <ActivityIndicator
                            IsRunning="{Binding IsLoading}"
                            IsVisible="{Binding IsLoading}"
                            Color="#667eea"/>

                        <!-- Сообщение об ошибке -->
                        <Label
                            IsVisible="{Binding HasError}"
                            Text="{Binding ErrorMessage}"
                            TextColor="Red"
                            FontSize="12"
                            HorizontalOptions="Center"/>

                    </VerticalStackLayout>
                </Frame>

                <!-- Версия -->
                <Label
                    FontSize="10"
                    HorizontalOptions="Center"
                    Text="Версия 1.0"
                    TextColor="White"
                    Opacity="0.7"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>