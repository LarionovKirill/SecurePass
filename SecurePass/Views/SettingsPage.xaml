<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SecurePass.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SecurePass.Controls"
    Title="Настройки">

    <VerticalStackLayout Margin="20" Spacing="16">
        <Label
            FontAttributes="Bold"
            FontSize="16"
            Text="Настройки генерации пароля"
            TextColor="{DynamicResource PrimaryTextColor}"/>

        <controls:SwitchWithLabel 
            IsSwitched="{Binding UseSpecialChars}" 
            Text="Использовать специальные символы"/>

        <controls:SwitchWithLabel 
            IsSwitched="{Binding UseUppercase}" 
            Text="Использовать заглавные буквы"/>

        <controls:SwitchWithLabel 
            IsSwitched="{Binding UseLowercase}" 
            Text="Использовать строчные буквы"/>

        <controls:SwitchWithLabel 
            IsSwitched="{Binding UseDigits}" 
            Text="Использовать цифры"/>

        <Label
            FontAttributes="Bold"
            FontSize="14"
            Text="Длина пароля"
            TextColor="{DynamicResource PrimaryTextColor}"/>

        <Slider
            Maximum="32"
            Minimum="6"
            Value="{Binding PasswordLength}"/>

        <Label 
            FontSize="14"
            HorizontalOptions="Center"
            Text="{Binding PasswordLength, StringFormat='Длина: {0}'}"
            TextColor="{DynamicResource SecondaryTextColor}"/>
    </VerticalStackLayout>
</ContentPage>