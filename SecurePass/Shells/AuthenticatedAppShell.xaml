<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SecurePass.Shells.AuthenticatedAppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:SecurePass.Views"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <Tab Title="Пароли" Icon="lock_icon_128x128.png">
            <ShellContent
                Title="Пароли"
                ContentTemplate="{DataTemplate views:MainPage}"
                Route="MainPage" />
        </Tab>

        <Tab Title="Настройки" Icon="gear_icon_128x128.png">
            <ShellContent
                Title="Настройки"
                ContentTemplate="{DataTemplate views:SettingsPage}"
                Route="SettingsPage" />
        </Tab>
    </TabBar>
</Shell>