<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="SecurePass.Controls.PasswordEntry"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="PasswordEntryControl">

    <Grid
        x:Name="MainGrid"
        ColumnDefinitions="*, Auto">
        <Entry
            x:Name="PasswordEntryField"
            Grid.Column="0"
            IsPassword="{Binding IsPasswordTrue, Source={x:Reference PasswordEntryControl}}"
            Text="{Binding Text, Source={x:Reference PasswordEntryControl}}"
            VerticalOptions="Center"/>

        <ImageButton
            x:Name="TogglePasswordButton"
            Grid.Column="1"
            BackgroundColor="Transparent"
            Clicked="TogglePasswordButton_Clicked"
            HeightRequest="22"
            HorizontalOptions="Center"
            Source="hide_eye_icon_128x128.png"
            VerticalOptions="Center"
            WidthRequest="22"/>
    </Grid>
</ContentView>
