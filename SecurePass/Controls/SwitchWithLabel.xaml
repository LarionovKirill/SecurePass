<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="SecurePass.Controls.SwitchWithLabel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="SwitchWithLabelControl">
    <Grid ColumnDefinitions="Auto, *, Auto">
        <Label
            Grid.Column="0"
            HorizontalOptions="Start"
            Text="{Binding Text, Source={x:Reference SwitchWithLabelControl}}"
            VerticalOptions="Center"/>

        <Switch
            Grid.Column="2"
            HorizontalOptions="End"
            IsToggled="{Binding IsSwitched, Source={x:Reference SwitchWithLabelControl}}"
            VerticalOptions="Center"/>
    </Grid>
</ContentView>